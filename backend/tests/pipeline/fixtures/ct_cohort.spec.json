{
  "spec_version": 2,
  "name": "ct_lesion_screen",
  "modality": "ct",
  "target_column": "lesion_present",
  "positive_label": "1",
  "adapter": "dicom_series",
  "source": { "root": "", "pattern": "ct_cohort" },
  "imaging": {
    "sequences": ["ct_window_soft_tissue"],
    "ct_windows": [[40, 400]],
    "orientation": "RAS",
    "voxel_spacing_mm": [1.0, 1.0, 1.0],
    "grid": [8, 32, 32]
  },
  "representation": {
    "kind": "deterministic",
    "extractor": "qhealth_qml.pipeline.extractors.reference_imaging:extract_imaging_features"
  },
  "split": { "strategy": "grouped", "test_size": 0.25, "validation_size": 0.2, "seed": 7 },
  "n_qubits": 4
}
