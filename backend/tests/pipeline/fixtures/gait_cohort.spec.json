{
  "spec_version": 2,
  "name": "gait_parkinsons_screen",
  "modality": "gait",
  "target_column": "parkinsons_event",
  "positive_label": "1",
  "adapter": "gait_txt",
  "source": { "root": "", "pattern": "gait_cohort" },
  "signal": {
    "channels": ["accel_x", "accel_y", "accel_z"],
    "native_hz": 50,
    "resample_to_hz": 50,
    "target_samples": 200,
    "length_norm": "crop_center",
    "per_record_normalize": "zscore"
  },
  "representation": {
    "kind": "deterministic",
    "extractor": "qhealth_qml.pipeline.extractors.reference_signal:extract_signal_features"
  },
  "split": { "strategy": "grouped", "test_size": 0.25, "validation_size": 0.2, "seed": 7 },
  "n_qubits": 4
}
