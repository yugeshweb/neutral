{
  "spec_version": 2,
  "name": "ecg_mi_screen",
  "modality": "ecg",
  "target_column": "mi_event",
  "positive_label": "1",
  "adapter": "wfdb_ecg",
  "source": { "root": "", "pattern": "ecg_cohort" },
  "signal": {
    "channels": ["I", "II", "III", "aVR", "aVL", "aVF", "V1", "V2", "V3", "V4", "V5", "V6"],
    "resample_to_hz": 250,
    "target_samples": 500,
    "filter": { "highpass_hz": 0.5, "lowpass_hz": 100 },
    "length_norm": "crop_center",
    "per_record_normalize": "median_std"
  },
  "representation": {
    "kind": "deterministic",
    "extractor": "qhealth_qml.pipeline.extractors.reference_signal:extract_signal_features"
  },
  "split": { "strategy": "grouped", "test_size": 0.25, "validation_size": 0.2, "seed": 7 },
  "n_qubits": 4
}
