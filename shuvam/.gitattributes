# Git LFS routing for this folder.
#
# Nothing currently committed here needs LFS -- the largest file is a 1.7 MB results
# JSON, well under GitHub's 50 MB warning and 100 MB hard limit. These rules exist so
# that binary artifacts added later go through LFS automatically rather than bloating
# the repository history, which cannot be undone without a rewrite.
#
# Model artifacts and caches
*.pkl  filter=lfs diff=lfs merge=lfs -text
*.pt   filter=lfs diff=lfs merge=lfs -text
*.pth  filter=lfs diff=lfs merge=lfs -text
*.npz  filter=lfs diff=lfs merge=lfs -text
*.npy  filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text

# Volumetric imaging, if an imaging modality ever ships a fixture
*.nii     filter=lfs diff=lfs merge=lfs -text
*.nii.gz  filter=lfs diff=lfs merge=lfs -text

# Note: dataset payloads (*.csv, *.dat, *.hea, *.edf, *.zip) are third-party licensed
# and excluded repository-wide by backend/.gitignore. They are not routed here because
# they should not be committed at all -- sync.sh fails if one appears in this folder.
